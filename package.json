{
  "name": "unforgettable-invites-web-templates",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "node serve.js",
    "assemble": "node tools/assemble_modular.js",
    "watch:sections": "node tools/assemble_modular.js --watch",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:mobile": "next dev -H 0.0.0.0 -p 3000",
    "build:css": "tailwindcss -i ./src/app/globals.css -o ./public/app.css",
    "watch:css": "tailwindcss -i ./src/app/globals.css -o ./public/app.css --watch",
    "cdn:sync": "node tools/sync_r2.js",
    "cdn:watch": "node tools/sync_r2.js --watch",
    "tunnel": "tools\\cloudflared.exe tunnel --url http://localhost:3000",
    "build": "npm run build:css && next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
